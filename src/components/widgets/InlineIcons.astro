  myNewIcon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
    <path d="..." fill="currentColor"/>
  </svg>`,
  
  */
};

// Handle rawSvg prop for immediate use
let selectedIcon;
if (rawSvg) {
  selectedIcon = parseSvg(rawSvg);
} else if (name && icons[name]) {
  selectedIcon = icons[name];
} else {
  // Default fallback
  selectedIcon = {
    viewBox: '0 0 24 24',
    defaultSize: '24',
    content: '<rect width="24" height="24" fill="currentColor"/>',
  };
}

const iconSize = size || selectedIcon.defaultSize;
---

<svg
  width={iconSize}
  height={iconSize}
  viewBox={selectedIcon.viewBox}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  set:html={selectedIcon.content}
/>
