---
export interface Props {
  name?: string;
  class?: string;
  size?: string;
  rawSvg?: string;
}

const { name, class: className = '', size, rawSvg } = Astro.props;

// Helper function to parse SVG and extract properties
function parseSvg(svgString: string) {
  const viewBoxMatch = svgString.match(/viewBox="([^"]*)"/);
  const widthMatch = svgString.match(/width="([^"]*)"/) || svgString.match(/width='([^']*)'/);
  const heightMatch = svgString.match(/height="([^"]*)"/) || svgString.match(/height='([^']*)'/);

  // Extract content between <svg> tags
  const contentMatch = svgString.match(/<svg[^>]*>(.*?)<\/svg>/s);
  const content = contentMatch ? contentMatch[1].trim() : '';

  const viewBox = viewBoxMatch ? viewBoxMatch[1] : '0 0 24 24';
  const defaultSize = widthMatch ? widthMatch[1] : heightMatch ? heightMatch[1] : '24';

  return {
    viewBox,
    defaultSize,
    content,
  };
}

